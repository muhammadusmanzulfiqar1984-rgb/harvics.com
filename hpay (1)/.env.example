PORT=3001
JWT_SECRET=hpay-prototype-2026-secret
VITE_HPAY_API_BASE=http://localhost:3001/api/v1

# Durable bank ledger
# Trial default: SQLite. Enterprise target: Postgres schema in db/schema/
HPAY_BANK_DB_PATH=./data/hpay-bank.sqlite
HPAY_BANK_ENGINE=sqlite
DATABASE_URL=postgres://hpay:hpay@localhost:5432/hpay

# Part 3 — External Integrations (auto = live when keys present, else sandbox)
HPAY_INTEGRATIONS_MODE=auto

# Institutional Custody & HSM
FIREBLOCKS_API_KEY=
FIREBLOCKS_API_SECRET=
BITGO_ACCESS_TOKEN=
AWS_KMS_KEY_ID=
AWS_REGION=

# Banking & Settlement Rails
SWIFT_BIC=
SWIFT_API_KEY=
CBUAE_CBDC_CLIENT_ID=
CBUAE_CBDC_CLIENT_SECRET=
FEDNOW_PARTICIPANT_ID=
ACH_ORIGINATOR_ID=

# Stablecoin & Digital Vaults
CIRCLE_API_KEY=
TETHER_TREASURY_API_KEY=

# Compliance & AML
CHAINALYSIS_API_KEY=
ELLIPTIC_API_KEY=
COMPLYADVANTAGE_API_KEY=

# Passkey Authentication
PASSAGE_API_KEY=
PASSAGE_APP_ID=
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# AI Model Gateway — Harvey (Gemini 2.5 Pro / Vertex)
GEMINI_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=us-central1
HARVEY_MODEL=gemini-2.5-pro

# ── Production adapters (HPAY-REAL-MONEY-V2) ──
FIREBLOCKS_API_BASE=https://api.fireblocks.io
FIREBLOCKS_VAULT_ACCOUNT_ID=0
CIRCLE_API_BASE=https://api.circle.com
CHAINALYSIS_API_BASE=https://api.chainalysis.com
GEMINI_MODEL=gemini-2.5-flash
# Set HARVEY_MODEL=gemini-3.6-flash when available on your Google project

# Postgres (production bank) — docker compose up -d postgres
DATABASE_URL=postgres://hpay:hpay@localhost:5432/hpay
HPAY_BANK_ENGINE=auto
PG_SSL=false

# WebAuthn / FIDO2 (L3)
WEBAUTHN_RP_NAME=HPay Security Enclave
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3001
# Demo only — set true to allow simulate_success without a real authenticator
WEBAUTHN_ALLOW_SIM=true

# Forex — RapidAPI Currency Conversion & Exchange Rates
RAPIDAPI_KEY=
RAPIDAPI_FOREX_HOST=currency-conversion-and-exchange-rates.p.rapidapi.com

# Crypto — RapidAPI Realtime Crypto Prices
RAPIDAPI_CRYPTO_HOST=realtime-crypto-prices.p.rapidapi.com

# Cloudflare deploy (npm run cf:deploy)
# Secrets: wrangler secret put DATABASE_URL JWT_SECRET RAPIDAPI_KEY
# CLOUDFLARE=1 is set automatically by wrangler.jsonc
VITE_INTERCOM_APP_ID=tnuivmad
VITE_INTERCOM_API_BASE=https://api-iam.intercom.io
VITE_HPAY_API_BASE=/api/v1

# Intercom Fin (same Harvics workspace)
VITE_INTERCOM_APP_ID=tnuivmad
VITE_INTERCOM_API_BASE=https://api-iam.intercom.io

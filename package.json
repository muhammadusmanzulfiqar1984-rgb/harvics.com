{
  "name": "harvics-localized-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3333",
    "backend": "tsx --tsconfig backend/tsconfig.json backend/src/index.ts",
    "backend:watch": "tsx watch --tsconfig backend/tsconfig.json backend/src/index.ts",
    "backend:build": "tsc -p backend/tsconfig.json",
    "backend:start": "node backend/dist/index.js",
    "build": "node scripts/build.mjs",
    "analyze": "ANALYZE=true next build; node scripts/copy-analyze-reports.mjs",
    "analyze:open": "ANALYZE=true ANALYZE_OPEN=true next build; node scripts/copy-analyze-reports.mjs",
    "lighthouse:home": "npx --yes lighthouse http://127.0.0.1:3001/en --only-categories=performance --preset=desktop --output=html --output=json --output-path=./.lighthouse/home --chrome-flags=\"--headless --no-sandbox --disable-gpu\"",
    "start:analyze": "next start -p 3001",
    "build:vietnam-deck": "node scripts/build-vietnam-denim-vite.mjs",
    "build:tabraiz-town": "npm --prefix apps/tabraiz-town run build",
    "build:cloudflare": "node scripts/build-vietnam-denim-vite.mjs && opennextjs-cloudflare build",
    "build:prod": "npm run backend:build && npm run build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy --cacheChunkSize=50",
    "deploy:fast": "opennextjs-cloudflare deploy --cacheChunkSize=50",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "lint": "next lint",
    "locales:sync": "node scripts/sync-locales.mjs",
    "locales:check": "node scripts/sync-locales.mjs --check",
    "locales:prune": "node scripts/sync-locales.mjs --prune-orphans --structure-only",
    "export": "next build && next export",
    "build:static": "next build && next export -o out",
    "build:netlify": "npm run build && echo 'Build complete! Upload the .next folder to Netlify.'",
    "clear-cache": "rm -rf .next && echo 'Cache cleared!'",
    "test-all": "./scripts/test-all.sh",
    "test": "./scripts/test-all.sh",
    "verify": "./scripts/test-all.sh",
    "start-servers": "./scripts/START_SERVERS.sh",
    "stop-servers": "./scripts/STOP_SERVERS.sh",
    "images:compress": "node scripts/compress-images.mjs",
    "images:bulk": "node scripts/compress-images.mjs --mode=bulk-copy",
    "import:leads": "node scripts/import-leads.mjs",
    "hx:import-master": "node scripts/hx-import-master-contacts.mjs",
    "hx:workers": "bash scripts/start-hx-workers.sh",
    "hx:workers:lean": "bash scripts/start-hx-workers-lean.sh",
    "hx:api": "bash -c 'set -a && source .env.hx && set +a && node --import tsx apps/api/server.ts'",
    "hx:deploy": "bash scripts/deploy-hx-api-fly.sh",
    "hx:health": "bash -c 'set -a && source .env.hx && set +a && node scripts/hx-health-check.mjs'",
    "kafka:consume": "bash -c 'set -a && source .env.hx && set +a && node --import tsx apps/workers/hx-kafka.consumer.ts'",
    "kafka:smoke": "bash -c 'set -a && source .env.hx && set +a && node --import tsx scripts/kafka-smoke.ts'",
    "pvideo": "node scripts/p-video-generate.mjs",
    "leads:sql": "node scripts/build-leads-d1-sql.mjs",
    "leads:d1:local": "node scripts/build-leads-d1-sql.mjs && wrangler d1 execute harvics-leads --local --file=migrations/0001_leads.sql && wrangler d1 execute harvics-leads --local --file=scripts/.gen/leads-d1.sql",
    "leads:d1:remote": "node scripts/build-leads-d1-sql.mjs && wrangler d1 execute harvics-leads --remote --file=migrations/0001_leads.sql && wrangler d1 execute harvics-leads --remote --file=scripts/.gen/leads-d1.sql"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@aws-sdk/client-s3": "^3.1057.0",
    "@clerk/nextjs": "^7.6.1",
    "@cloudflare/realtimekit-react": "^2.0.0",
    "@cloudflare/realtimekit-react-ui": "^2.0.0",
    "@cursor/sdk": "^1.0.18",
    "@huggingface/inference": "^4.13.18",
    "@intercom/messenger-js-sdk": "^0.0.20",
    "@opennextjs/cloudflare": "^1.19.11",
    "@prisma/client": "^6.19.2",
    "@react-google-maps/api": "^2.20.7",
    "@studio-freight/lenis": "^1.0.42",
    "@types/google.maps": "^3.58.1",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vapi-ai/web": "^2.6.1",
    "@vercel/analytics": "^2.0.1",
    "autoprefixer": "^10.4.20",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.80.2",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.19.2",
    "framer-motion": "^12.40.0",
    "groq-sdk": "^1.2.1",
    "gsap": "^3.15.0",
    "helmet": "^7.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "lucide-react": "^1.7.0",
    "mapbox-gl": "^3.24.0",
    "next": "^15.5.18",
    "next-intl": "^3.26.5",
    "pg": "^8.22.0",
    "postcss": "^8.4.47",
    "prisma": "^6.19.2",
    "puppeteer": "^24.36.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-is": "^19.2.7",
    "recharts": "^3.5.0",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stripe": "^22.3.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "undici": "^6.19.8",
    "wrangler": "^4.95.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.11",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/prop-types": "^15.7.15",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.0.0",
    "tsx": "^4.7.1"
  },
  "keywords": [
    "corporate",
    "website",
    "harvics",
    "localization",
    "i18n"
  ],
  "author": "Harvics",
  "license": "ISC",
  "description": "Localized corporate website for Harvics - Dubai, UAE"
}

generator client {
  provider = "prisma-client-js"
  // Keep Meet client local so we never overwrite the monorepo Prisma client.
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MeetingStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum ParticipantRole {
  HOST
  CO_HOST
  PARTICIPANT
}

enum RSVPStatus {
  PENDING
  ACCEPTED
  TENTATIVE
  DECLINED
}

enum AccessType {
  OPEN
  INVITED
  RESTRICTED
}

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?

  accounts      Account[]
  sessions      Session[]
  meetings      Meeting[]      @relation("HostMeetings")
  participants  Participant[]
  invitations   Invitation[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Meeting {
  id             String             @id @default(cuid())
  title          String
  description    String?

  hostId         String
  host           User               @relation("HostMeetings", fields: [hostId], references: [id])

  startTime      DateTime
  endTime        DateTime
  timezone       String

  status         MeetingStatus      @default(SCHEDULED)
  accessType     AccessType         @default(INVITED)

  meetingCode    String             @unique
  roomName       String             @unique

  waitingRoom    Boolean            @default(false)
  recording      Boolean            @default(false)
  transcription  Boolean            @default(false)
  aiSummary      Boolean            @default(true)

  recurrenceRule String?

  participants   Participant[]
  invitations    Invitation[]
  artifacts      MeetingArtifact[]

  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([hostId])
  @@index([startTime])
  @@index([status])
}

model Participant {
  id          String          @id @default(cuid())

  meetingId   String
  userId      String?

  meeting     Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user        User?           @relation(fields: [userId], references: [id])

  email       String?
  displayName String

  role        ParticipantRole @default(PARTICIPANT)
  rsvp        RSVPStatus      @default(PENDING)

  joinedAt    DateTime?
  leftAt      DateTime?

  createdAt   DateTime        @default(now())

  @@index([meetingId])
  @@index([userId])
  @@index([email])
}

model Invitation {
  id          String     @id @default(cuid())

  meetingId   String
  userId      String?

  meeting     Meeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user        User?      @relation(fields: [userId], references: [id])

  email       String
  token       String     @unique @default(cuid())

  status      RSVPStatus @default(PENDING)

  sentAt      DateTime?
  respondedAt DateTime?

  createdAt   DateTime   @default(now())

  @@index([meetingId])
  @@index([email])
  @@index([token])
}

model MeetingArtifact {
  id         String   @id @default(cuid())

  meetingId  String
  meeting    Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  type       String
  storageKey String?
  content    String?

  createdAt  DateTime @default(now())

  @@index([meetingId])
}

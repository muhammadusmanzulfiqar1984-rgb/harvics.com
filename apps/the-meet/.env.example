# Harvics Meet — apps/the-meet
# Copy to .env.local and fill values.

# App
NEXTAUTH_URL=http://localhost:3010
NEXTAUTH_SECRET=replace-with-long-random-string
# Optional alias used by auth.ts fallback
JWT_SECRET=

# Database — dedicated Neon DB `harvics_meet` (do NOT use monorepo neondb)
DATABASE_URL=postgresql://USER:PASS@HOST/harvics_meet?sslmode=require

# LiveKit Cloud (required for video join)
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Email (Resend)
RESEND_API_KEY=
MEET_FROM_EMAIL="Harvics Meet <meet@harvics.com>"

# Redis (optional — waiting room / rate limits)
REDIS_URL=

# Cloudflare R2 (recordings / transcripts)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# AI
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# Inngest (reminders / follow-ups)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Observability (optional)
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Google Gemini API (Required for the AI Concierge and Voice processing)
GEMINI_API_KEY=

# Google Maps JavaScript API (Required for search grounding and map integration)
VITE_GOOGLE_MAPS_API_KEY=

# Aviationstack Live Flights API Key (optional — quota limited)
AVIATIONSTACK_API_KEY=

# Duffel Flights API (primary — hotels/cars via Duffel when enabled)
# Test tokens start with duffel_test_
DUFFEL_ACCESS_TOKEN=

# Booking.com via RapidAPI (hotels + attractions)
# Note: key must be subscribed to booking-com15 (not booking-com-api5)
RAPIDAPI_KEY=
RAPIDAPI_BOOKING_HOST=booking-com15.p.rapidapi.com

# TripAdvisor via RapidAPI (restaurants / dining)
# Subscribe to: https://rapidapi.com/apiheya/api/tripadvisor16
RAPIDAPI_TRIPADVISOR_HOST=tripadvisor16.p.rapidapi.com

# Skyscanner Flights via RapidAPI (airport lookup + fare compare)
RAPIDAPI_SKYSCANNER_HOST=skyscanner-flights-travel-api.p.rapidapi.com

# Weather via RapidAPI
RAPIDAPI_WEATHER_HOST=weather-api167.p.rapidapi.com

# Live FX via RapidAPI
RAPIDAPI_FX_HOST=exchange-rate-api1.p.rapidapi.com

# Expedia cars via RapidAPI (luxury rentals)
# Subscribe to: https://rapidapi.com/DataCrawler/api/expedia15
RAPIDAPI_EXPEDIA_HOST=expedia15.p.rapidapi.com
